# ====================================
# Web Trends Timeline - Backend Environment Variables
# ====================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# For development: use SQLite
# For production: use PostgreSQL
DATABASE_URL=sqlite:./database.db
# DATABASE_URL=postgresql://user:password@localhost:5432/webtrends

# JWT Authentication
# IMPORTANT: Change this to a secure random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Stripe Payment Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_price_id

# For production, use live keys:
# STRIPE_SECRET_KEY=sk_live_your_stripe_live_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret
# STRIPE_PRICE_ID=price_your_live_price_id

# CORS Configuration
# In production, set this to your frontend URL
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://webtrends.com

# Admin Configuration
# Comma-separated list of admin emails
ADMIN_EMAILS=admin@example.com,admin@webtrends.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Email Configuration
# For Gmail: use smtp.gmail.com, port 587, and app-specific password
# For SendGrid: use smtp.sendgrid.net, port 587, and API key as password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@webtrends.com
EMAIL_FROM_NAME=Web Trends Timeline
